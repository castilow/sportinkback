# ============================================================
# Sportink Backend — variables de entorno
# Copia este archivo a ".env" y rellena los valores reales.
# NO subas el .env real al repositorio.
# ============================================================

# --- Base de datos Mongo (legacy / opcional) ---
MONGO_URL=
DB_NAME=sportink

# --- Seguridad ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
COOKIE_SECURE=True
# Cross-site (Vercel→Render): none. Localhost: lax
COOKIE_SAMESITE=none

# --- Supabase / Postgres ---
# Usa el connection string del POOLER (Session mode, puerto 5432).
DATABASE_URL=
DIRECT_URL=
SUPABASE_DB_PASSWORD=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT Secret (Settings → API). Sin esto cada /auth/me llama a Auth remoto (~7–12s).
SUPABASE_JWT_SECRET=
# Token de Management API: solo para migraciones locales. En Render web: vacío.
SUPABASE_ACCESS_TOKEN=
# true = forzar Management API (lento). En producción: false.
USE_SUPABASE_MGMT=false
# Omite seeds demo en el arranque (más rápido en Render).
SKIP_SEED=true

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://sportinksoft.vercel.app

# --- Admin inicial (solo se crea si no existe) ---
ADMIN_EMAIL=admin@sportink.app
ADMIN_PASSWORD=
